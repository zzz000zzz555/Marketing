# ============================================================
# NÓRDICO STUDIO — Variables de entorno (Fase 1)
# Copiar a .env.local para desarrollo y a .env.production en servidor.
# NINGún valor real de credencial debe subirse al repositorio.
# Los valores CHANGE_ME son obligatorios antes de desplegar.
# ============================================================

# --- Aplicación ------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="NÓRDICO STUDIO"
NEXT_PUBLIC_CONTACT_EMAIL="hola@nordico.pe"

# --- Base de datos PostgreSQL ----------------------------------
# DATABASE_URL: pooler (PgBouncer) para runtime serverless.
# DIRECT_URL: conexión directa para `prisma migrate deploy`.
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/nordico?schema=public&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/nordico?schema=public"

# --- Autenticación (Auth.js v5) --------------------------------
AUTH_SECRET="CHANGE_ME_OPENSSL_RAND_BASE64_32"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"
SESSION_MAX_AGE_SECONDS="86400"
MFA_REQUIRED_FOR_ADMIN="true"

# Cifrado AES-256-GCM del secreto TOTP (32 bytes en base64)
MFA_ENCRYPTION_KEY="CHANGE_ME_BASE64_32_BYTES"

# --- Google OAuth 2.0 / OIDC -----------------------------------
# Requerido: verificar email_verified === true en el callback.
AUTH_GOOGLE_ID="CHANGE_ME.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="CHANGE_ME"

# --- Supabase (opcional, solo si se conserva como backend) -----
NEXT_PUBLIC_SUPABASE_URL="https://CHANGE_ME.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="CHANGE_ME"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME_SOLO_SERVIDOR"

# --- Pasarelas de pago (tokenización PCI-DSS) ------------------
PAYMENT_PROVIDER="culqi" # culqi | niubiz | mercadopago
CULQI_PUBLIC_KEY="CHANGE_ME"
CULQI_SECRET_KEY="CHANGE_ME_SOLO_SERVIDOR"
NIBUZ_MERCHANT_ID="CHANGE_ME"
NIBUZ_API_KEY="CHANGE_ME_SOLO_SERVIDOR"
MERCADO_PAGO_ACCESS_TOKEN="CHANGE_ME_SOLO_SERVIDOR"
PAYMENT_WEBHOOK_SECRET="CHANGE_ME"

# --- Facturación electrónica SUNAT -----------------------------
BILLING_PROVIDER="nubefact" # nubefact | facturalo
BILLING_API_URL="https://api.nubefact.com/api/v1/CHANGE_ME"
BILLING_API_TOKEN="CHANGE_ME_SOLO_SERVIDOR"
SUNAT_RUC="20XXXXXXXXX"
SUNAT_RAZON_SOCIAL="RAZÓN SOCIAL S.A.C."
SUNAT_DOMICILIO_FISCAL="Dirección completa, Lima, Perú"
SUNAT_SOL_USER="CHANGE_ME"
SUNAT_SOL_PASSWORD="CHANGE_ME_SOLO_SERVIDOR"

# --- Reglas de negocio (siempre en servidor) -------------------
IGV_RATE="0.18"
FREE_SHIPPING_THRESHOLD="250.00"
DEFAULT_SHIPPING_COST="15.00"
DEFAULT_CURRENCY="PEN"
LOW_STOCK_THRESHOLD="5"
ORDER_NUMBER_PREFIX="ND"
COMPLAINT_CODE_PREFIX="LR"

# --- Correo transaccional (pedidos, ARCO, reclamos) ------------
EMAIL_PROVIDER="resend"
RESEND_API_KEY="CHANGE_ME_SOLO_SERVIDOR"
EMAIL_FROM="NÓRDICO STUDIO <no-reply@nordico.pe>"
COMPLAINT_COPY_EMAIL="reclamos@nordico.pe"

# --- Almacenamiento de imágenes WebP/AVIF ----------------------
STORAGE_BUCKET_URL="https://CHANGE_ME.supabase.co/storage/v1/object/public/productos"
STORAGE_SERVICE_KEY="CHANGE_ME_SOLO_SERVIDOR"

# --- Seguridad, rate limiting y observabilidad -----------------
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_LOGIN_WINDOW_MS="900000"
RATE_LIMIT_CHECKOUT_MAX="10"
RATE_LIMIT_CHECKOUT_WINDOW_MS="60000"
RATE_LIMIT_API_MAX="120"
RATE_LIMIT_API_WINDOW_MS="60000"
SECURITY_HEADERS_ENABLED="true"
AUDIT_LOG_RETENTION_DAYS="2555" # 7 años (ISO 27001 / SUNAT)
CONSENT_LOG_RETENTION_DAYS="1095"

# --- Modo rendimiento / animaciones ----------------------------
ENABLE_SEASONAL_PARTICLES="true"
MAX_CANVAS_PARTICLES="120"
