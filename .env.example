# ============================================
# NÓRDICO STUDIO — Variables de entorno
# Copia este archivo a .env.local / .env.production y completa los valores
# ============================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nordico?schema=public&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/nordico?schema=public"

# --- Auth (Auth.js / NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# --- Google OAuth (OIDC) ---
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"

# --- Supabase (si se usa como backend) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # SOLO servidor, nunca exponer al cliente

# --- Pasarela de pagos (Culqi / Niubiz / Mercado Pago) ---
PAYMENT_PROVIDER="culqi"
PAYMENT_PUBLIC_KEY="pk_..."
PAYMENT_SECRET_KEY="sk_..."          # SOLO servidor
PAYMENT_WEBHOOK_SECRET="whsec_..."

# --- Facturación electrónica (OSE/PSE) ---
BILLING_PROVIDER="nubefact"
BILLING_API_URL="https://api.nubefact.com/api/v1/..."
BILLING_API_TOKEN="..."
BILLING_RUC="20XXXXXXXXX"
BILLING_RAZON_SOCIAL="RAZÓN SOCIAL S.A.C."
BILLING_DOMICILIO_FISCAL="Dirección completa, Lima, Perú"

# --- Email transaccional ---
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="re_..."
EMAIL_FROM="NÓRDICO STUDIO <no-reply@nordico.pe>"

# --- Seguridad / Rate limiting ---
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_LOGIN_WINDOW_MS="900000"
RATE_LIMIT_CHECKOUT_MAX="10"
RATE_LIMIT_CHECKOUT_WINDOW_MS="60000"

# --- Entorno ---
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="NÓRDICO STUDIO"