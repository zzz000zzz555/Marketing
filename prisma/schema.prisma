// ============================================================
// NÓRDICO STUDIO — Esquema canónico PostgreSQL (Prisma)
// Fase 1: estructura de datos completa.
//
// Invariantes de seguridad (ISO/IEC 27001):
//  - Precios, stock, IGV (18%), envío (> S/ 250 gratis) y descuentos
//    se calculan SIEMPRE en servidor. El cliente nunca envía totales.
//  - Ningún dato de tarjeta (PAN/CVV) se persiste. Solo tokens de pasarela.
//  - AuditLog es append-only: sin updatedAt y sin ON DELETE CASCADE.
//  - Los secretos MFA se guardan cifrados (AES-256-GCM) por la aplicación.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BundleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignSeason {
  DEFAULT
  NAVIDAD
  FIESTAS_PATRIAS
  ANIO_NUEVO
  CYBER
  SAN_VALENTIN
}

enum ThemeMode {
  LIGHT
  DARK
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  CULQI
  NIBUZ
  MERCADO_PAGO
}

enum DocumentType {
  BOLETA
  FACTURA
}

enum InvoiceStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  VOIDED
}

enum ComplaintType {
  QUEJA
  RECLAMO
}

enum ComplaintStatus {
  PENDIENTE
  EN_PROCESO
  RESUELTO
  CERRADO
}

enum ArcoRight {
  ACCESO
  RECTIFICACION
  CANCELACION
  OPOSICION
  PORTABILIDAD
}

enum ArcoStatus {
  PENDIENTE
  EN_PROCESO
  RESUELTO
  RECHAZADO
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  MFA_ENABLED
  MFA_DISABLED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  BUNDLE_CREATED
  BUNDLE_UPDATED
  BUNDLE_DELETED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_ACTIVATED
  REVIEW_CREATED
  REVIEW_MODERATED
  CART_UPDATED
  ORDER_CREATED
  ORDER_PAID
  ORDER_CANCELLED
  REFUND_ISSUED
  INVOICE_ISSUED
  COMPLAINT_CREATED
  COMPLAINT_RESOLVED
  CONSENT_RECORDED
  ARCO_REQUEST_CREATED
  SETTINGS_UPDATED
}

// ------------------------------------------------------------
// Identidad y acceso (Auth.js + RBAC + MFA)
// ------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  passwordHash      String? // Argon2id/bcrypt; nulo cuando el alta es solo OAuth
  image             String?
  emailVerified     DateTime?
  role              Role      @default(CUSTOMER)
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String? // AES-256-GCM; MFA obligatorio para ADMIN
  mfaRecoveryHashes String[] // códigos de recuperación hasheados
  phone             String?
  documentType      String? // DNI | RUC | pasaporte
  documentNumber    String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  cart             Cart?
  orders           Order[]
  favorites        Favorite[]
  reviews          ProductReview[]     @relation("ReviewAuthor")
  moderatedReviews ProductReview[]     @relation("ReviewModerator")
  reviewVotes      ReviewHelpfulVote[]
  complaintReplies ComplaintBook[]
  arcoRequests     ArcoRequest[]
  cookieConsents   CookieConsent[]
  auditLogs        AuditLog[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String // "oauth" | "oidc" | "email"
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------
// Catálogo: productos, especificaciones y combos
// ------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id                String        @id @default(cuid())
  sku               String        @unique
  slug              String        @unique
  name              String // "[Tipo] [Línea] — [Material/Atributo]"
  subtitle          String? // beneficio principal
  description       String
  brand             String?
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id])
  price             Decimal       @db.Decimal(12, 2)
  compareAtPrice    Decimal?      @db.Decimal(12, 2)
  currency          String        @default("PEN")
  stock             Int           @default(0)
  reservedStock     Int           @default(0)
  lowStockThreshold Int           @default(5)
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  badge             String?
  images            Json // [{ url, alt, width, height, format: "webp"|"avif" }]
  warrantyMonths    Int           @default(12)
  deliveryEstimate  String?
  ratingAverage     Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount       Int           @default(0)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  specs      ProductSpec[]
  reviews    ProductReview[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  favorites  Favorite[]
  bundleItems BundleItem[]

  @@index([status, categoryId])
  @@index([slug])
  @@index([isFeatured, status])
  @@index([stock])
}

model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String // "Materiales" | "Dimensiones" | "Cuidados" | "Qué incluye"
  key       String
  label     String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId, group])
}

model Bundle {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  subtitle    String?
  description String
  image       String?
  packPrice   Decimal      @db.Decimal(12, 2)
  listPrice   Decimal      @db.Decimal(12, 2) // suma de ítems a precio individual
  savings     Decimal      @db.Decimal(12, 2) // listPrice - packPrice
  currency    String       @default("PEN")
  status      BundleStatus @default(DRAFT)
  isFeatured  Boolean      @default(false)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items      BundleItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([status, isFeatured])
  @@index([validFrom, validUntil])
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Decimal  @db.Decimal(12, 2) // snapshot para recalcular listPrice
  position  Int     @default(0)

  // Stock del pack = min(floor(product.stock / quantity)); se calcula en servidor.
  @@unique([bundleId, productId])
  @@index([bundleId])
}

// ------------------------------------------------------------
// Campañas y festividades
// ------------------------------------------------------------

model CampaignTheme {
  id             String         @id @default(cuid())
  key            String         @unique // "navidad-2026", "fiestas-patrias-2026"
  season         CampaignSeason
  name           String
  description    String?
  status         CampaignStatus @default(DRAFT)
  mode           ThemeMode      @default(LIGHT)
  palette        Json // { light: {base,surface,text,border,accent}, dark: {...} }
  svgAssets      Json // { header, hero, divider, footer } claves SVG reales
  particleConfig Json? // { enabled, layers, wind, gravity, colors }
  bubbleTitle    String?
  bubbleSubtitle String?
  bubbleCtaText  String?
  bubbleCtaUrl   String?
  showCountdown  Boolean        @default(false)
  countdownTo    DateTime?
  performanceSafe Boolean       @default(true)
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Solo una campaña ACTIVE a la vez: se garantiza con transacción + índice
  // parcial en la migración SQL.
  @@index([status, startsAt, endsAt])
  @@index([season, status])
}

// ------------------------------------------------------------
// Reseñas verificadas
// ------------------------------------------------------------

model ProductReview {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId           String
  author             User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  rating             Int // 1..5; validado en servidor
  title              String?
  body               String
  verifiedPurchase   Boolean      @default(false) // se calcula contra OrderItem pagado
  status             ReviewStatus @default(PENDING)
  helpfulCount       Int          @default(0)
  officialResponse   String?
  officialResponseAt DateTime?
  moderatorId        String?
  moderator          User?        @relation("ReviewModerator", fields: [moderatorId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  helpfulVotes ReviewHelpfulVote[]

  @@unique([productId, authorId]) // 1 reseña por usuario y producto
  @@index([productId, status, rating])
  @@index([status, createdAt])
}

model ReviewHelpfulVote {
  id        String        @id @default(cuid())
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([reviewId, userId])
}

// ------------------------------------------------------------
// Carrito server-side (sin precios ni stock en localStorage)
// ------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  bundleId  String?
  bundle    Bundle?  @relation(fields: [bundleId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Exactamente uno de productId / bundleId debe estar presente (validado en API).
  @@unique([cartId, productId])
  @@unique([cartId, bundleId])
  @@index([cartId])
}

// ------------------------------------------------------------
// Pedidos, pagos tokenizados y facturación SUNAT
// ------------------------------------------------------------

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique // ND-XXXXXXXX
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  tax              Decimal       @db.Decimal(12, 2) // IGV 18%
  shipping         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  currency         String        @default("PEN")
  couponCode       String?
  documentType     DocumentType  @default(BOLETA)
  customerDocument String? // DNI/RUC para SUNAT
  recipientName    String
  recipientPhone   String
  addressLine1     String
  addressLine2     String?
  city             String
  region           String
  postalCode       String?
  country          String        @default("PE")
  notes            String?
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items   OrderItem[]
  payments Payment[]
  invoice Invoice?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  bundleId  String?
  bundle    Bundle?  @relation(fields: [bundleId], references: [id])
  name      String // snapshot del nombre al comprar
  sku       String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  tax       Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  snapshot Json // imagen, atributos y desglose del combo

  @@index([orderId])
  @@index([productId])
  @@index([bundleId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway     PaymentGateway
  externalId  String        @unique // id de la transacción en la pasarela
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("PEN")
  status      PaymentStatus @default(PENDING)
  method      String // "card" | "yape" | "plin"
  token       String? // token de la pasarela; NUNCA PAN ni CVV
  cardLast4   String? // últimos 4 dígitos, permitido por PCI-DSS
  fee         Decimal       @default(0) @db.Decimal(12, 2)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  documentType  DocumentType
  series        String
  number        String
  status        InvoiceStatus @default(PENDING)
  externalId    String? // id del comprobante en Nubefact/Facturalo
  xmlUrl        String?
  pdfUrl        String?
  cdrUrl        String?
  sunatResponse Json?
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([series, number])
  @@index([status, issuedAt])
}

// ------------------------------------------------------------
// Cumplimiento: Libro de Reclamaciones, ARCO, cookies, auditoría
// ------------------------------------------------------------

model ComplaintBook {
  id                     String          @id @default(cuid())
  code                   String          @unique // correlativo INDECOPI
  type                   ComplaintType
  status                 ComplaintStatus @default(PENDIENTE)
  claimantName           String
  claimantDocumentType   String
  claimantDocumentNumber String
  claimantEmail          String
  claimantPhone          String
  claimantAddress        String?
  orderNumber            String?
  productSku             String?
  subject                String
  description            String
  amount                 Decimal?        @db.Decimal(12, 2)
  requestedResolution    String
  response               String?
  respondedById          String?
  respondedBy            User?           @relation(fields: [respondedById], references: [id])
  respondedAt            DateTime?
  emailSentAt            DateTime?
  pdfUrl                 String? // copia PDF del reclamo
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([code])
  @@index([status, createdAt])
  @@index([claimantEmail])
}

model ArcoRequest {
  id          String     @id @default(cuid())
  code        String     @unique
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  right       ArcoRight
  email       String
  details     String
  status      ArcoStatus @default(PENDIENTE)
  response    String?
  respondedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([code])
  @@index([status, createdAt])
}

model CookieConsent {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  sessionId     String
  purposes      Json // { necessary:true, analytics, marketing, personalization }
  policyVersion String
  ipHash        String // IP hasheada (SHA-256 + salt), nunca en claro
  userAgent     String?
  grantedAt     DateTime @default(now())
  revokedAt     DateTime?

  @@index([sessionId])
  @@index([userId, grantedAt])
}

// Append-only: sin updatedAt, sin ON DELETE CASCADE.
// La cuenta de base de datos de la app tiene revocados UPDATE/DELETE.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  actorRole  Role?
  action     AuditAction
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Policy {
  key       String   @id
  title     String
  content   String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
